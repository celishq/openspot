<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Openspot</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Openspot spot</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>dev.openspot.spot</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Openspot</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Openspot runs your plugins, and a plugin can ask another app to act, such as to paste.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Openspot shows and adds your events when a spot that you use asks for them.</string>
	<key>NSCameraUsageDescription</key>
	<string>Openspot records the camera when a plugin records the screen with your camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Openspot records the microphone when a plugin records the screen with your voice.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Openspot shows, adds and ticks your reminders when a spot that you use asks for them.</string>
	<key>OpenspotDevState</key>
	<string>$(OPENSPOT_DEV_STATE)</string>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://github.com/celishq/openspot/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>$(UPDATE_PUBLIC_KEY)</string>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Openspot spot</string>
			<key>UTTypeIdentifier</key>
			<string>dev.openspot.spot</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>spot</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
